REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_INSIGHT_HOST_PORT=8001
REDIS_DB=0

REDIS_INDEX_NAME=rag_index
REDIS_DOC_PREFIX=rag:chunk:

DATA_DIR=data

EMBEDDING_PROVIDER=local

EMBEDDING_DIM=768
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=3

# Optional debug mode for detailed API error messages.
GEMINI_DEBUG=false

# LLM provider for final answer generation: deepseek or gemini
LLM_PROVIDER=deepseek

# DeepSeek config (required only when LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Optional Gemini config (required only if using Gemini)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-2.0-flash
